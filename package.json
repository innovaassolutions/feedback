{
  "name": "course-feedback-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "e2e": "playwright test",
    "db:reset": "supabase db reset && tsx scripts/seed.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "test:db": "tsx scripts/test-db.ts",
    "jobs": "tsx scripts/run-jobs.ts",
    "evals": "tsx evals/run.ts",
    "evals:gate": "tsx scripts/check-eval-reports.ts",
    "db:types": "supabase gen types typescript --local --schema public > lib/database.types.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.146",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@vocalbridgeai/react": "^0.1.1",
    "@vocalbridgeai/sdk": "^0.1.1",
    "ai": "^7.0.173",
    "mammoth": "^1.13.0",
    "next": "^16.4.6",
    "node-html-parser": "^9.0.7",
    "nodemailer": "^10.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "robots-parser": "^3.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "postgres": "^4.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
