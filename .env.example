# Copy to .env.local and fill in. Never commit real values.

# Supabase. Local values come from `supabase status -o env` after `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Used only in lib/server/: seeding, background jobs and token-authorized interview writes.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Models, through the Vercel AI Gateway. Leave AI_PROVIDER empty to use the gateway when a key
# is present and the stub model otherwise. Set AI_PROVIDER=stub to force the stub.
AI_PROVIDER=
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-sonnet-5.5
# Optional per-agent overrides. Each falls back to AI_MODEL.
AI_MODEL_INTERVIEWER=
AI_MODEL_ANALYST=
AI_MODEL_LIBRARIAN=
AI_MODEL_BRAND_DESIGNER=
AI_MODEL_JUDGE=
# Optional: the Interviewer's model for spoken turns only, where reply time matters most. Unset, voice uses
# the Interviewer's model. Claude Haiku 5.5 was tried and failed the evals (83.7%), so it isn't the default.
AI_MODEL_INTERVIEWER_VOICE=
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
# How much the model reasons before answering. Defaults to minimal: every call's output budget is sized
# for the answer alone. One of minimal, low, medium, high (or provider-default).
AI_REASONING=
# Prices for agent_runs cost, in US dollars per million tokens, used when the gateway doesn't report cost.
AI_PRICE_INPUT_PER_MTOK=3
AI_PRICE_OUTPUT_PER_MTOK=15

# Voice (Vocal Bridge). The key never reaches the browser.
VOCAL_BRIDGE_API_KEY=
VOCAL_BRIDGE_AGENT_ID=
# Defaults to https://vocalbridgeai.com. Tests point it somewhere unreachable.
VOCAL_BRIDGE_API_URL=

# Email. Development sends to the local Supabase inbox over SMTP; production uses Resend.
EMAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
RESEND_API_KEY=
EMAIL_FROM=Course Feedback <feedback@platform.example>

# Background jobs. Vercel Cron sends this as a bearer token to /api/cron/tick.
CRON_SECRET=
